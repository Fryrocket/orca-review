[Unit]
Description=Supervised KILN Studio for the ORCA Workbench
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/fryrocket/.local/lib/kiln-studio/kiln-studio.py
Restart=always
RestartSec=3
TimeoutStopSec=10
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
Slice=app.slice

[Install]
WantedBy=graphical-session.target
