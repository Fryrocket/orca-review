[Desktop Entry]
Type=Application
Version=1.0
Name=KILN Studio Autostart
Comment=Start the ORCA Workbench after the KILN desktop session is ready
Exec=/home/fryrocket/.local/lib/kiln-studio/kiln-studio.py
Icon=kiln-studio
Terminal=false
OnlyShowIn=GNOME;Unity;
X-GNOME-Autostart-enabled=true
X-GNOME-AutoRestart=true
X-GNOME-Autostart-Delay=3
NoDisplay=true
