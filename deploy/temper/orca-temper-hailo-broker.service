[Unit]
Description=ORCA TEMPER signed bounded Hailo job broker
After=local-fs.target

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
StateDirectory=orca-temper
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/lib/orca/temper_hailo_broker.py --state-root /var/lib/orca-temper
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
CPUQuota=200%
Nice=5
UMask=0027
TimeoutStartSec=120
