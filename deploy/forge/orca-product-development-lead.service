[Unit]
Description=ORCA Product Development Lead bounded planning worker
After=orca.service
Wants=orca.service

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
Environment=PYTHONPATH=/opt/orca/current
ExecStart=/usr/local/lib/orca/orca_product_development_lead.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=orca-product-development-lead
StateDirectoryMode=0750
ReadOnlyPaths=-/var/lib/orca-product-development-input
ReadWritePaths=/var/lib/orca-product-development-lead
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
UMask=0027
