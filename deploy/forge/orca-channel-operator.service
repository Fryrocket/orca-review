[Unit]
Description=ORCA Channel Operator draft-only multichannel worker
After=orca.service
Wants=orca.service

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
Environment=PYTHONPATH=/opt/orca/current
ExecStart=/usr/local/lib/orca/orca_channel_operator.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=orca-channel-operator
StateDirectoryMode=0750
ReadOnlyPaths=-/var/lib/orca-channel-input
ReadWritePaths=/var/lib/orca-channel-operator
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
UMask=0027
