[Unit]
Description=ORCA Daily Briefing Officer read-only report compiler
After=orca.service
Wants=orca.service

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
ExecStart=/usr/local/lib/orca/orca_daily_briefing_officer.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=orca-daily-briefing-officer
StateDirectoryMode=0750
ReadOnlyPaths=-/var/lib/orca-daily-briefing-input
ReadWritePaths=/var/lib/orca-daily-briefing-officer
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
UMask=0027
