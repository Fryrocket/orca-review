[Unit]
Description=ORCA policy-first control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fryrocket
Group=fryrocket
UMask=0077
WorkingDirectory=/opt/orca/current
Environment=PYTHONUNBUFFERED=1
Environment=ORCA_CRUCIBLE_ACCEPTANCE_FILE=/var/lib/orca/crucible-acceptance.json
Environment=ORCA_ENABLED_MODEL_SERVICES=forge_deepseek,forge_smith,kiln_quench
Environment=ORCA_INVENTORY_SSH_KEY=/var/lib/orca/inventory-ssh-key
Environment=ORCA_INVENTORY_KNOWN_HOSTS=/var/lib/orca/inventory-known-hosts
ExecStart=/usr/bin/python3 -m orca --host 127.0.0.1 --port 8787 --database /var/lib/orca/orca-events.db --identity-token-file /var/lib/orca/identity-tokens.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
