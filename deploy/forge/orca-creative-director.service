[Unit]
Description=ORCA Creative Director draft media coordinator
After=orca.service
Wants=orca.service

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
Environment=PYTHONPATH=/opt/orca/current
ExecStart=/usr/local/lib/orca/orca_creative_director.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=orca-creative-director
StateDirectoryMode=0750
ReadOnlyPaths=-/var/lib/orca-creative-input
ReadWritePaths=/var/lib/orca-creative-director
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
UMask=0027
