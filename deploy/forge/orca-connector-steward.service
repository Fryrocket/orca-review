[Unit]
Description=ORCA Connector Steward read-only registry observer
After=orca.service
Wants=orca.service

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
ExecStart=/usr/local/lib/orca/orca_connector_steward.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca-connector-steward
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallFilter=@system-service
UMask=0027
