[Unit]
Description=ORCA Fleet Heartbeat Agent (%i) — signed health + peer ping
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
ExecStart=/usr/bin/python3 /usr/local/lib/orca/fleet_heartbeat_agent.py --node %i --secret-file /etc/orca/fleet-heartbeat.secret
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca-fleet-heartbeat
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
UMask=0027
