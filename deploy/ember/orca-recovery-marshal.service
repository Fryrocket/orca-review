[Unit]
Description=ORCA Recovery Marshal read-only evidence observer
After=orca-backup.service orca-offsite-sync.service

[Service]
Type=oneshot
User=fryrocket
Group=fryrocket
ExecStart=/usr/local/lib/orca/recovery_marshal.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/orca-backup /var/lib/orca-offsite
ReadWritePaths=/var/lib/orca-recovery-marshal
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
UMask=0027
