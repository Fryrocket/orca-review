[Unit]
Description=ORCA KILN signed heartbeat and inference node
After=network-online.target orca-forge-tunnel.service smith-inference.service quench-inference.service
Wants=network-online.target orca-forge-tunnel.service

[Service]
Type=simple
User=fryrocket
Group=fryrocket
UMask=0077
WorkingDirectory=/opt/orca-node/current
ExecStart=/usr/bin/python3 /opt/orca-node/current/scripts/kiln_heartbeat_agent.py --key-file /var/lib/orca-node/kiln-heartbeat.key --state-file /var/lib/orca-node/heartbeat-state.json --interval 30
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca-node
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
