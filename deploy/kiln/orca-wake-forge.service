[Unit]
Description=ORCA wake and verify FORGE from KILN
After=network-online.target orca-forge-tunnel.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/orca-recovery/orca_wake_guard.py --target FORGE --mac 30:c5:99:f1:20:13 --broadcast 192.168.7.255 --tcp 192.168.7.30:22 --health-url http://127.0.0.1:18787/api/health --state-file /var/lib/orca-recovery/forge.json --failures-before-wake 3 --retries 3 --retry-wait 45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca-recovery
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_RAW

