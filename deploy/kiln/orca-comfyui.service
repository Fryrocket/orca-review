[Unit]
Description=ORCA local SDXL generation on KILN
After=network-online.target
Wants=network-online.target
Conflicts=quench-inference.service
ConditionPathExists=/home/fryrocket/forge-workspace/forge/ComfyUI/main.py
ConditionPathExists=/home/fryrocket/forge-workspace/forge/ComfyUI/models/checkpoints/sd_xl_base_1.0.safetensors

[Service]
Type=simple
User=fryrocket
Group=fryrocket
WorkingDirectory=/home/fryrocket/forge-workspace/forge/ComfyUI
Environment=HOME=/home/fryrocket
ExecStart=/home/fryrocket/forge-workspace/ml-env/bin/python main.py --listen 127.0.0.1 --port 8188 --lowvram --cpu-vae --preview-method none --disable-auto-launch
Restart=no
TimeoutStartSec=180
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fryrocket/forge-workspace/forge/ComfyUI/output /home/fryrocket/forge-workspace/forge/ComfyUI/temp /home/fryrocket/forge-workspace/forge/ComfyUI/user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

